{
  "name": "ha-axi",
  "version": "0.1.0",
  "description": "AXI CLI for Home Assistant — token-efficient TOON output, REST + WebSocket, safe confirmed mutations",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thelad-dev/ha-axi.git"
  },
  "homepage": "https://github.com/thelad-dev/ha-axi#readme",
  "bugs": {
    "url": "https://github.com/thelad-dev/ha-axi/issues"
  },
  "keywords": [
    "home-assistant",
    "homeassistant",
    "ha",
    "cli",
    "agent",
    "axi",
    "toon"
  ],
  "bin": {
    "ha-axi": "dist/bin/ha-axi.js"
